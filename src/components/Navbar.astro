---
import { getCollection } from "astro:content";
import { name } from "spectre:globals";
import Icon from "./Icon.astro";

const path = Astro.url.pathname;
const [posts, projects] = await Promise.all([
	getCollection("posts", (post) => post.data.draft !== true),
	getCollection("projects"),
]);
const searchEntries = [
	...posts.map((post) => ({
		title: post.data.title,
		description: post.data.description,
		href: `/blog/${post.id}`,
		type: "Post",
		keywords: post.data.tags.map((tag) => tag.id).join(" "),
	})),
	...projects.map((project) => ({
		title: project.data.title,
		description: project.data.description,
		href: `/projects/${project.id}`,
		type: "Project",
		keywords: "",
	})),
];

// Hour ticks for the theme dial (every 15deg, longer at the quarter marks).
// The dial is centered at (100, 110) with radius 80.
const ticks = Array.from({ length: 24 }, (_, i) => {
	const angle = (i * 15 * Math.PI) / 180;
	const cardinal = i % 6 === 0;
	const r1 = cardinal ? 68 : 74;
	const r2 = 80;
	return {
		x1: (100 + r1 * Math.cos(angle)).toFixed(2),
		y1: (110 + r1 * Math.sin(angle)).toFixed(2),
		x2: (100 + r2 * Math.cos(angle)).toFixed(2),
		y2: (110 + r2 * Math.sin(angle)).toFixed(2),
		cardinal,
	};
});
---
<nav>
  <a class="site-title" href="/">{name}</a>
  <ul>
    <li>
      <a href="/blog" class:list={{ active: path.startsWith('/blog') }}>Blog</a>
    </li>
    <li class="nav-separator">/</li>
    <li>
      <a href="/projects" class:list={{ active: path.startsWith('/projects') }}>Projects</a>
    </li>
    <li class="nav-separator">/</li>
    <li>
      <button id="search-toggle" aria-label="Search" title="Search (Ctrl+K)">
        <Icon type="lucide" name="search" width={20} height={20} />
      </button>
    </li>
    <li class="nav-separator">/</li>
    <li class="theme-picker">
      <button id="theme-toggle" aria-label="Change theme" title="Change theme">
        <Icon type="lucide" name="sun-moon" width={20} height={20} />
      </button>
      <div id="theme-popover">
        <svg
          id="theme-dial"
          viewBox="0 0 200 200"
          role="slider"
          tabindex="0"
          aria-label="Time of day"
          aria-valuemin={0}
          aria-valuemax={100}
          aria-valuenow={50}
        >
          <defs>
            <radialGradient id="dial-ocean" cx="35%" cy="35%" r="80%">
              <stop offset="0%" stop-color="#4a9edb" />
              <stop offset="100%" stop-color="#1c4e7e" />
            </radialGradient>
            <linearGradient id="dial-terminator" x1="128" y1="110" x2="72" y2="110">
              <stop offset="0%" stop-color="rgba(2, 6, 18, 0)" />
              <stop offset="42%" stop-color="rgba(2, 6, 18, 0)" />
              <stop offset="58%" stop-color="rgba(2, 6, 18, 0.88)" />
              <stop offset="100%" stop-color="rgba(2, 6, 18, 0.95)" />
            </linearGradient>
            <clipPath id="dial-earth-clip">
              <circle cx="0" cy="0" r="28" />
            </clipPath>
          </defs>
          {
            ticks.map((tick) => (
              <line
                x1={tick.x1}
                y1={tick.y1}
                x2={tick.x2}
                y2={tick.y2}
                class:list={["dial-tick", { cardinal: tick.cardinal }]}
              />
            ))
          }
          <circle cx="100" cy="110" r="80" class="dial-ring" />
          <text x="100" y="51" class="dial-hour" id="dial-hour-noon">12:00</text>
          <text x="159" y="110" class="dial-hour" id="dial-hour-sunset">18:00</text>
          <text x="100" y="169" class="dial-hour" id="dial-hour-midnight">0:00</text>
          <text x="41" y="110" class="dial-hour" id="dial-hour-sunrise">6:00</text>
          <circle cx="100" cy="110" r="56" class="dial-orbit" />
          <line x1="30" y1="110" x2="170" y2="110" class="dial-horizon" />
          <g id="dial-sun" transform="translate(156 110)">
            <circle r="8" class="dial-sun-core" />
          </g>
          <g id="dial-moon" transform="translate(44 110)">
            <g transform="translate(-7 -7) scale(0.583)">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" class="dial-moon-body" />
            </g>
          </g>
          <circle cx="100" cy="110" r="32" class="dial-atmosphere" />
          <g transform="translate(100 110)">
            <circle cx="0" cy="0" r="28" fill="url(#dial-ocean)" />
            <g clip-path="url(#dial-earth-clip)">
              <g id="dial-land">
                <path
                  d="M -22 -10 Q -12 -20 -3 -12 Q 4 -5 -2 3 Q -11 8 -18 1 Q -26 -4 -22 -10 Z"
                  class="dial-continent"
                />
                <path
                  d="M 7 -16 Q 19 -19 24 -8 Q 27 1 17 4 Q 8 5 5 -4 Q 3 -11 7 -16 Z"
                  class="dial-continent"
                />
                <path
                  d="M 3 12 Q 10 10 13 16 Q 11 22 4 21 Q -2 17 3 12 Z"
                  class="dial-continent"
                />
                <path d="M -13 -24 A 28 28 0 0 1 13 -24 Q 0 -17 -13 -24 Z" class="dial-ice" />
              </g>
            </g>
          </g>
          <circle cx="100" cy="110" r="28" fill="url(#dial-terminator)" />
        </svg>
        <span id="theme-phase-label">12:00 · Noon</span>
        <div class="theme-presets">
          <button class="theme-preset" data-phase="0.25">
            <Icon type="lucide" name="sunrise" width={14} height={14} />
            Sunrise
          </button>
          <button class="theme-preset" data-phase="0.5">
            <Icon type="lucide" name="sun" width={14} height={14} />
            Noon
          </button>
          <button class="theme-preset" data-phase="0.75">
            <Icon type="lucide" name="sunset" width={14} height={14} />
            Sunset
          </button>
          <button class="theme-preset" data-phase="0">
            <Icon type="lucide" name="moon" width={14} height={14} />
            Night
          </button>
        </div>
        <label class="theme-auto">
          <input type="checkbox" id="theme-auto-check" checked />
          Follow the sun
        </label>
      </div>
    </li>
  </ul>
  <button class="mobile-nav-toggle" aria-label="Mobile menu trigger">
    <Icon type="lucide" name="menu" width={24} height={24} class="menu-closed" />
    <Icon type="lucide" name="x" width={24} height={24} class="menu-open" />
  </button>
</nav>
<div id="search-dialog" aria-hidden="true">
  <button id="search-backdrop" aria-label="Close search"></button>
  <section class="search-panel" role="dialog" aria-modal="true" aria-labelledby="search-title">
    <div class="search-input-row">
      <Icon type="lucide" name="search" width={20} height={20} aria-hidden="true" />
      <input id="search" type="text" placeholder="Search the site" autocomplete="off" />
      <button id="search-close" aria-label="Close search" title="Close search">
        <Icon type="lucide" name="x" width={20} height={20} />
      </button>
    </div>
    <p id="search-title" class="search-hint">Search posts and projects <kbd>Esc</kbd> to close</p>
    <div id="search-results" aria-live="polite"></div>
  </section>
</div>
<script src="../scripts/theme-picker.ts"></script>
<script is:inline define:vars={{ searchEntries }}>
  const searchElement = document.querySelector('#search');
  const results = document.querySelector('#search-results');
  const searchDialog = document.querySelector('#search-dialog');
  const searchToggle = document.querySelector('#search-toggle');
  const searchClose = document.querySelector('#search-close');
  const searchBackdrop = document.querySelector('#search-backdrop');
  const navToggle = document.querySelector('.mobile-nav-toggle');

  let focusIndex = -1;
  const renderResults = (query) => {
    if (!results) return;

    const terms = query.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
    results.replaceChildren();
    if (terms.length === 0) return;

    const matches = searchEntries
      .map((entry) => {
        const searchable = `${entry.title} ${entry.description} ${entry.type} ${entry.keywords}`.toLocaleLowerCase();
        const score = terms.reduce((total, term) => total + (searchable.includes(term) ? 1 : 0), 0);
        return { entry, score };
      })
      .filter(({ score }) => score === terms.length)
      .sort((a, b) => a.entry.title.localeCompare(b.entry.title));

    if (matches.length === 0) {
      const empty = document.createElement('p');
      empty.textContent = 'No results found';
      results.append(empty);
      return;
    }

    for (const { entry } of matches) {
      const link = document.createElement('a');
      const title = document.createElement('h3');
      const description = document.createElement('p');
      const type = document.createElement('span');

      link.href = entry.href;
      title.className = 'no-mt';
      title.textContent = entry.title;
      description.textContent = entry.description;
      type.className = 'search-result-type';
      type.textContent = entry.type;
      link.append(title, description, type);
      results.append(link);
    }
  };

  const openSearch = () => {
    if (!searchDialog || !searchElement) return;
    searchDialog.classList.add('active');
    searchDialog.setAttribute('aria-hidden', 'false');
    searchElement.focus();
  };

  const closeSearch = () => {
    if (!searchDialog) return;
    searchDialog.classList.remove('active');
    searchDialog.setAttribute('aria-hidden', 'true');
    focusIndex = -1;
    searchToggle?.focus();
  };

  document.addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() === 'k' && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      openSearch();
      return;
    }

    if (e.key === 'Escape' && searchDialog?.classList.contains('active')) {
      closeSearch();
      return;
    }

    if (e.key === 'ArrowDown' && searchDialog?.classList.contains('active')) {
      e.preventDefault();

      focusIndex++;
      const results = document.querySelectorAll('#search-results a');

      if (focusIndex >= results.length) {
        focusIndex = 0;
      }

      results[focusIndex]?.focus();
    }

    if (e.key === 'ArrowUp' && searchDialog?.classList.contains('active')) {
      e.preventDefault();

      focusIndex--;
      const results = document.querySelectorAll('#search-results a');

      if (focusIndex < 0) {
        focusIndex = results.length - 1;
      }

      results[focusIndex]?.focus();
    }
  });

  searchElement?.addEventListener('input', (e) => renderResults(e.target.value));

  searchToggle?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);
  searchBackdrop?.addEventListener('click', closeSearch);

  navToggle?.addEventListener('click', () => {
    navToggle.classList.toggle('active');
    document.querySelector('nav').classList.toggle('active');
  });

</script>
<style>
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Cascadia Code', 'Courier New', Courier, monospace;
    z-index: 50;
  }

  .site-title {
    font-weight: 800;
    text-decoration: none;
    font-size: 1.25em;
    color: var(--heading);
    letter-spacing: -0.04em;
    z-index: 2;
  }

  nav ul {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style-type: none;
    align-items: center;
  }

  nav ul li {
    position: relative;
  }

  nav a {
    color: inherit;
    text-decoration: none;
    padding: .25rem .5rem;
    border-radius: 999px;
    transition: color .2s ease, text-shadow .2s ease;
  }

  nav a:hover,
  nav a.active {
    color: var(--fg);
    text-shadow: 0 0 .8rem rgb(var(--primary-rgb) / 75%);
  }

  nav a:focus-visible {
    color: var(--fg);
    outline: 2px solid var(--focus-ring);
    outline-offset: .2rem;
  }

  .mobile-nav-toggle {
    display: none;
    width: 40px;
    height: 40px;
    background-color: var(--card-bg);
    border: 1px solid var(--border);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    border-radius: var(--radius-sm);
  }

  .theme-picker {
    display: flex;
    align-items: center;
  }

  #search-toggle,
  #theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    border-radius: 999px;
    color: var(--fg);
    cursor: pointer;
    padding: .25rem .5rem;
    overflow: visible;
  }

  #search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    cursor: pointer;
    padding: 0;
  }

  #search-toggle svg,
  #theme-toggle svg,
  #search-close svg { display: block; flex: none; }

  #search-toggle:hover,
  #search-toggle:focus-visible,
  #theme-toggle:hover,
  #theme-toggle:focus-visible,
  #search-close:hover,
  #search-close:focus-visible {
    background-color: transparent;
    color: var(--fg);
    box-shadow: var(--interaction-glow);
    outline: none;
  }

  #search-dialog {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: start center;
    padding: min(14vh, 8rem) var(--space-3) var(--space-3);
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s ease;
  }

  #search-dialog.active {
    opacity: 1;
    pointer-events: auto;
  }

  #search-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--bg) 76%, transparent);
    backdrop-filter: blur(0.35rem);
    -webkit-backdrop-filter: blur(0.35rem);
    cursor: default;
  }

  .search-panel {
    position: relative;
    width: min(42rem, 100%);
    max-height: min(38rem, calc(100vh - 2rem));
    overflow: auto;
    background: var(--card-bg);
    border: 1px solid color-mix(in srgb, var(--border) 55%, var(--primary));
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-hover);
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border-bottom: 1px solid var(--border);
    color: var(--primary);
  }

  #search {
    min-width: 0;
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--fg);
  }

  #search::placeholder { color: var(--fg-muted); }

  .search-hint {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    color: var(--fg-muted);
    font-size: .8125rem;
  }

  kbd {
    padding: .125rem .375rem;
    border: 1px solid var(--border);
    border-radius: .25rem;
    background: var(--surface-raised);
    color: var(--fg);
    font: inherit;
    font-size: .75rem;
  }

  #search-results {
    min-height: 0;
    padding: 0 var(--space-2) var(--space-2);
  }

  #search-results:empty::before {
    content: "Start typing to search";
    display: block;
    padding: var(--space-3);
    color: var(--fg-muted);
    font-size: .875rem;
  }

  #theme-popover {
    position: absolute;
    top: calc(100% + .5rem);
    right: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: .75rem;
    width: 240px;
    padding: 1rem;
    background-color: color-mix(in srgb, var(--card-bg) 90%, transparent);
    border: 1px solid var(--primary);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 20;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-hover);
  }

  #theme-popover.active {
    display: flex;
  }

  #theme-dial {
    width: 100%;
    height: auto;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  #theme-dial:active {
    cursor: grabbing;
  }

  #theme-dial:focus-visible {
    outline: 1px solid var(--primary);
  }

  .dial-tick {
    stroke: var(--border);
    stroke-width: 1.5;
  }

  .dial-tick.cardinal {
    stroke: var(--primary);
  }

  .dial-ring {
    fill: rgba(var(--primary-rgb), 0.05);
    stroke: var(--border);
    stroke-width: 1;
  }

  .dial-hour {
    fill: var(--fg-muted);
    font-size: 8px;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .dial-orbit {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    opacity: .5;
  }

  .dial-horizon {
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    opacity: .7;
  }

  #dial-sun,
  #dial-moon {
    transition: opacity .3s ease;
  }

  .dial-sun-core {
    fill: #ffd75e;
    filter: drop-shadow(0 0 6px #ffd75e);
  }

  .dial-moon-body {
    fill: var(--fg-muted);
  }

  .dial-atmosphere {
    fill: none;
    stroke: rgba(120, 180, 255, 0.3);
    stroke-width: 1.5;
  }

  .dial-continent {
    fill: #46a06b;
  }

  .dial-ice {
    fill: rgba(255, 255, 255, 0.85);
  }

  #theme-phase-label {
    font-size: .875em;
    color: var(--fg-muted);
  }

  .theme-presets {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .5rem;
    width: 100%;
  }

  .theme-preset {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    padding: .25rem .5rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--fg);
    font: inherit;
    font-size: .8125em;
    cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease;
  }

  .theme-preset:hover,
  .theme-preset:focus-visible {
    border-color: color-mix(in srgb, var(--border) 45%, var(--primary));
    background-color: transparent;
    box-shadow: var(--interaction-glow);
    outline: none;
  }

  .theme-auto {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .875em;
    color: var(--fg-muted);
    cursor: pointer;
    user-select: none;
  }

  .theme-auto input {
    accent-color: var(--primary);
    cursor: pointer;
  }

  .menu-open {
    display: none;
  }

  .mobile-nav-toggle.active .menu-open {
    display: flex;
  }

  .mobile-nav-toggle.active .menu-closed {
    display: none;
  }

  @media screen and (max-width: 720px) {
    nav {
      position: relative;
      padding: 0 1rem;
      padding-top: 1rem;
      transition: all .25s ease;
    }

    .mobile-nav-toggle {
      display: flex;
    }

    .nav-separator {
      display: none;
    }

    nav ul {
      flex-direction: column;
      gap: .25rem;
      position: fixed;
      top: 50%;
      left: 50%;
      width: min(calc(100vw - 2rem), 22rem);
      max-height: calc(100dvh - 2rem);
      height: auto;
      padding: var(--space-2);
      z-index: 60;
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, calc(-50% - .75rem));
      transition: opacity .2s ease, transform .2s ease, background-color .6s ease;
      user-select: none;
      align-items: stretch;
      background: transparent;
      border: 1px solid transparent;
      border-radius: var(--radius-lg);
      overflow-y: auto;
    }

    nav.active {
      background: transparent;
    }

    nav.active ul {
      opacity: 1;
      pointer-events: all;
      transform: translate(-50%, -50%);
      background-color: color-mix(in srgb, var(--card-bg) 94%, var(--primary));
      border: 1px solid color-mix(in srgb, var(--border) 55%, var(--primary));
      box-shadow: var(--shadow-soft), var(--interaction-glow);
      backdrop-filter: blur(1rem);
      -webkit-backdrop-filter: blur(1rem);
    }

    nav ul li {
      position: relative;
      transition: transform .2s ease, opacity .2s ease;
      transform: translateY(-.5rem);
      opacity: 0;
      width: 100%;
      max-width: none;
      padding: 0;
      font-size: 1em;
    }
  
    nav ul li a,
    nav ul li #search-toggle,
    nav ul li #theme-toggle {
      display: flex;
      align-items: center;
      min-height: 3rem;
      padding: .75rem 1rem;
      width: 100%;
      border-radius: var(--radius-sm);
    }

    nav ul li a:hover,
    nav ul li #search-toggle:hover,
    nav ul li #theme-toggle:hover {
      background: var(--surface-interactive);
    }

    nav.active ul li {
      transform: translateY(0);
      opacity: 1;
    }

    .mobile-nav-toggle.active {
      background: var(--surface-raised);
      border-color: var(--primary);
      box-shadow: var(--interaction-glow);
    }

  }
</style>
<style is:global>
  #search-results a {
    display: block;
    text-decoration: none;
    color: var(--fg) !important;
    padding: .5rem;
    border-radius: var(--radius-sm);
  }

  #search-results a:hover, #search-results a:focus-visible {
    background-color: transparent;
    color: var(--fg) !important;
    box-shadow: var(--interaction-glow);
    outline: none;
  }

  #search-results a:hover mark, #search-results a:focus-visible mark {
    background-color: var(--primary);
    color: var(--on-primary);
  }

  #search-results a h3 {
    margin-bottom: .5rem;
  }

  .search-result-type {
    color: var(--fg-muted);
    font-size: .75rem;
  }

  #search-results a p {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #search-results mark {
    background-color: var(--primary);
    color: var(--on-primary);
  }

  .separator {
    margin: .5rem .5rem;
    border: none;
    height: 1px;
    background-color: var(--border);
  }
</style>
