---
import "../styles/index.css";

import { getCollection, getEntry, render } from "astro:content";
import { name, openGraph } from "spectre:globals";
import ProfilePicture from "../assets/pfp.png";
import Card from "../components/Card.astro";
import EntryPreview from "../components/EntryPreview.astro";
import Icon from "../components/Icon.astro";
import ImageGlow from "../components/ImageGlow.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Layout from "../layouts/Layout.astro";
import { getGitHubData } from "../lib/github";

const [posts, projects, about, workExperience, quickInfo, site] =
	await Promise.all([
		getCollection("posts", (post) => post.data.draft !== true),
		getCollection("projects"),
		getEntry("other", "about"),
		getCollection("workExperience"),
		getCollection("quickInfo"),
		getEntry("site", "profile"),
	]);

const github = site ? await getGitHubData(site.data.github.username) : null;

const { Content: About } = await render(about!);

const languageIcons: Record<
	string,
	{ type: "lucide" | "simple-icons"; name: string }
> = {
	TypeScript: { type: "simple-icons", name: "typescript" },
	Rust: { type: "simple-icons", name: "rust" },
	Lua: { type: "simple-icons", name: "lua" },
	Python: { type: "simple-icons", name: "python" },
	Nix: { type: "simple-icons", name: "nixos" },
	HTML: { type: "simple-icons", name: "html5" },
	CSS: { type: "simple-icons", name: "css3" },
	Shell: { type: "simple-icons", name: "gnubash" },
};
---

<Layout
	title={openGraph.home.title || name}
	description={openGraph.home.description}
	pagefindIgnore
>
	<div class="layout-grid-left" slot="left">
		<Card class="flex-col-card">
			{
				github ? (
					<ImageGlow
						shape="circle"
						quality={100}
						width={120}
						height={120}
						src={github.user.avatar_url}
						alt="Didac's GitHub profile picture."
						loading="eager"
					/>
				) : (
					<ImageGlow
						shape="circle"
						quality={100}
						width={120}
						height={120}
						src={ProfilePicture}
						alt="A purple, minimalist looking ghost."
						loading="eager"
					/>
				)
			}
			<h2>{name}</h2>
			<ul class="overview-list">
				{
					quickInfo.map((info) => (
						<li>
							<Icon
								type={info.data.icon.type}
								name={info.data.icon.name as any}
								width={24}
								height={24}
								class="glow-icon"
							/>
							<span>{info.data.text}</span>
						</li>
					))
				}
			</ul>
		</Card>
		<Card>
			<h3 class="no-mt">Socials</h3>
			<ul class="overview-list">
				{
					site?.data.socials.map((item) => (
						<li>
							<a href={item.link} class="socials-link">
								<Icon
									type={item.icon.type}
									name={item.icon.name as any}
									width={24}
									height={24}
									class="glow-icon"
								/>
								<span>{item.text}</span>
							</a>
						</li>
					))
				}
			</ul>
		</Card>
		{
			github && (
				<Card>
					<h3 class="no-mt">GitHub</h3>
					<ul class="overview-list">
						<li>
							<a href={github.user.html_url} class="socials-link">
								<Icon
									type="lucide"
									name="github"
									width={24}
									height={24}
									class="glow-icon"
								/>
								<span>@{github.user.login}</span>
							</a>
						</li>
						<li>
							<Icon
								type="lucide"
								name="calendar"
								width={24}
								height={24}
								class="glow-icon"
							/>
							<span>Member since {github.memberSince}</span>
						</li>
					</ul>
					<div class="stats-grid">
						<div class="stat">
							<h3 class="text-glow">{github.stats.repos}</h3>
							<span>Repositories</span>
						</div>
						<div class="stat">
							<h3 class="text-glow">{github.stats.followers}</h3>
							<span>Followers</span>
						</div>
						<div class="stat">
							<h3 class="text-glow">{github.stats.following}</h3>
							<span>Following</span>
						</div>
						<div class="stat">
							<h3 class="text-glow">{github.stats.stars}</h3>
							<span>Stars</span>
						</div>
					</div>
					{github.languages.length > 0 && (
						<div class="github-languages">
							<h3 class="no-mt">Top Languages</h3>
							<ul class="overview-list">
								{github.languages.map((language) => {
									const icon = languageIcons[language.name] ?? {
										type: "lucide" as const,
										name: "code",
									};
									return (
										<li>
											<Icon
												type={icon.type}
												name={icon.name as any}
												width={24}
												height={24}
												class="glow-icon"
											/>
											<span>{language.name}</span>
										</li>
									);
								})}
							</ul>
						</div>
					)}
				</Card>
			)
		}
	</div>
	<div class="layout-grid-right" slot="right">
		<Card>
			<SectionHeader title="About me" icon={{ type: "lucide", name: "user" }} />
			<div class="prose">
				<About />
			</div>
		</Card>
		<Card>
			<SectionHeader title="Latest Posts" icon={{ type: "lucide", name: "rss" }} />
			<div class="content-container">
				{
					posts
						.sort(
							(a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime(),
						)
						.slice(0, 2)
						.map((post) => <EntryPreview href={`/blog/${post.id}`} title={post.data.title} description={post.data.description} meta={post.data.createdAt.toLocaleDateString()} tags={post.data.tags.map((tag) => tag.id)} />)
				}
			</div>
		</Card>
		<Card>
			<SectionHeader title="Latest Projects" icon={{ type: "lucide", name: "folder-git" }} />
			<div class="content-container">
				{
					projects
						.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
						.slice(0, 2)
						.map((project) => <EntryPreview href={`/projects/${project.id}`} title={project.data.title} description={project.data.description} meta={project.data.date.toLocaleDateString()} />)
				}
			</div>
		</Card>
		<Card>
			<SectionHeader title="Work Experience" icon={{ type: "lucide", name: "briefcase-business" }} />
			<div class="work-experience-container">
				{
					workExperience.reverse().map((entry) => (
						<div class="work-experience-entry">
							<span class="work-experience-duration">
								{entry.data.duration}
							</span>
							<h3 class="work-experience-company">{entry.data.company}</h3>
							<span class="work-experience-role">{entry.data.title}</span>
							<p class="work-experience-desc">{entry.data.description}</p>
						</div>
					))
				}
			</div>
		</Card>
	</div>
</Layout>
